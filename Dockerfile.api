# AutoPharmaX API image - FastAPI + torch (CPU) + rdkit.
# Inference is not GPU-bound (<50 ms/request on CPU), so the CPU wheel
# keeps the image ~1 GB instead of ~6 GB and makes the demo portable.
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app

WORKDIR /app

# System libs required by rdkit + scientific stack.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        build-essential \
        libxrender1 libxext6 libsm6 \
        libgomp1 \
        curl \
 && rm -rf /var/lib/apt/lists/*

# Install Python deps first (better layer caching). torch CPU from the
# dedicated index; everything else from PyPI.
COPY requirements.txt ./
RUN pip install --index-url https://download.pytorch.org/whl/cpu "torch>=2.1.0" \
 && pip install \
        rdkit \
        "scikit-learn>=1.3" \
        "scipy>=1.11" \
        "pandas>=2.0" \
        "numpy>=1.24,<3.0" \
        "pyarrow>=14.0" \
        "mlflow>=2.8,<3.0" \
        "great-expectations>=0.18,<1.0" \
        pyyaml \
        "fastapi>=0.104" \
        "uvicorn[standard]>=0.24" \
        "pydantic>=2.0" \
        python-multipart \
        "shap>=0.43" \
        matplotlib seaborn \
        requests tqdm openpyxl

# Copy source. data/ is bind-mounted at runtime so the image stays small.
COPY src/       ./src/
COPY params.yaml ./
COPY metrics.json ./metrics.json

EXPOSE 8000

# Simple liveness probe hits /health; startup is ~15s (model + caches).
HEALTHCHECK --interval=20s --timeout=5s --start-period=45s --retries=5 \
    CMD curl -fsS http://127.0.0.1:8000/health || exit 1

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
